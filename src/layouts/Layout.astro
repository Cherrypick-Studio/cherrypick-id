---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHero from '../components/Section/SectionHero.astro';
import SectionAboutUs from '../components/Section/SectionAboutUs.astro';
import SectionTime from '../components/Section/SectionTime.astro';
import SectionClient from '../components/Section/SectionClients.astro';
import SectionPorto from '../components/Section/SectionPorto.astro';
import SectionPrice from '../components/Section/SectionPrice.astro';
import SectionReview from '../components/Section/SectionReview.astro';
import SectionFAQ from '../components/Section/SectionFAQ.astro';
import SectionProjects from '../components/Section/SectionProjects.astro';
import SectionBanner from '../components/Section/SectionBanner.astro';

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': 'https://id.cherrypick.studio/#business',
	name: 'Cherrypick Studio',
	image: 'https://id.cherrypick.studio/og-image.jpg',
	description:
		'Jasa pembuatan website profesional untuk bisnis UMKM hingga perusahaan dengan harga terjangkau dan desain modern',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Malang',
		addressRegion: 'East Java',
		addressCountry: 'ID',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: -7.9666,
		longitude: 112.6326,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
	areaServed: [
		{ '@type': 'City', name: 'Malang' },
		{ '@type': 'State', name: 'Jawa Timur' },
		{ '@type': 'Country', name: 'Indonesia' },
	],
	telephone: '+6282326546380',
	email: 'hello@cherrypick.id',
	url: 'https://id.cherrypick.studio',
	priceRange: 'Rp 150.000 - Rp 4.500.000',
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+6282326546380',
		contactType: 'customer service',
		email: 'hello@cherrypick.id',
		availableLanguage: 'Indonesian',
		areaServed: 'ID',
	},
	sameAs: [
		'https://www.facebook.com/cherrypickid.studio',
		'https://www.instagram.com/cherrypick.studioid/',
		'https://www.linkedin.com/company/cherrypick-studio/',
		'https://www.behance.net/cherrypick-studio',
		'https://dribbble.com/cherrypick-studio',
	],
};

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': 'https://id.cherrypick.studio/#organization',
	name: 'Cherrypick Studio',
	url: 'https://id.cherrypick.studio',
	logo: {
		'@type': 'ImageObject',
		url: 'https://id.cherrypick.studio/favicon.svg',
	},
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+6282326546380',
		contactType: 'customer service',
		email: 'hello@cherrypick.id',
		availableLanguage: 'Indonesian',
		areaServed: 'ID',
	},
	sameAs: [
		'https://www.facebook.com/cherrypickid.studio',
		'https://www.instagram.com/cherrypick.studioid/',
		'https://www.linkedin.com/company/cherrypick-studio/',
	],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': 'https://id.cherrypick.studio/#website',
	url: 'https://id.cherrypick.studio',
	name: 'Cherrypick Studio',
	publisher: {
		'@id': 'https://id.cherrypick.studio/#organization',
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Berapa lama waktu pengerjaan website?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Waktu pengerjaan website bervariasi tergantung kompleksitas proyek. Untuk website landing page sederhana membutuhkan 3-5 hari kerja, website company profile 1-2 minggu, dan untuk website e-commerce atau custom 2-4 minggu.',
			},
		},
		{
			'@type': 'Question',
			name: 'Apakah bisa request revisi setelah website jadi?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Tentu bisa! Kami menyediakan 3x revisi gratis setelah website selesai. Untuk revisi tambahan atau perubahan besar, akan dikenakan biaya tambahan sesuai dengan scope pekerjaan.',
			},
		},
		{
			'@type': 'Question',
			name: 'Apakah termasuk domain dan hosting?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Untuk paket tahunan, domain .com dan hosting sudah termasuk dalam harga. Untuk paket bulanan, Anda perlu menyediakan hosting sendiri atau bisa menggunakan layanan hosting kami dengan biaya terpisah.',
			},
		},
		{
			'@type': 'Question',
			name: 'Bagaimana sistem pembayarannya?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Pembayaran dilakukan dengan sistem DP 50% di awal dan pelunasan 50% setelah website selesai. Kami menerima transfer bank, e-wallet, dan kartu kredit.',
			},
		},
		{
			'@type': 'Question',
			name: 'Apakah website-nya responsive untuk mobile?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Ya, semua website yang kami buat sudah responsive dan mobile-friendly. Website akan tampil optimal di semua perangkat termasuk smartphone, tablet, dan desktop.',
			},
		},
		{
			'@type': 'Question',
			name: 'Apakah ada layanan maintenance setelah website jadi?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Kami menyediakan layanan maintenance bulanan yang mencakup update keamanan, backup rutin, monitoring uptime, dan support teknis. Harga maintenance mulai dari Rp 100.000/bulan.',
			},
		},
	],
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	'@id': 'https://id.cherrypick.studio/#service',
	name: 'Jasa Pembuatan Website Profesional',
	description:
		'Layanan pembuatan website untuk bisnis UMKM hingga perusahaan dengan harga terjangkau, desain modern, dan SEO friendly.',
	provider: {
		'@id': 'https://id.cherrypick.studio/#organization',
	},
	areaServed: [
		{ '@type': 'City', name: 'Malang' },
		{ '@type': 'State', name: 'Jawa Timur' },
		{ '@type': 'Country', name: 'Indonesia' },
	],
	serviceType: 'Web Design and Development',
	offers: [
		{
			'@type': 'Offer',
			name: 'Landing Page Basic',
			description:
				'Landing page responsif 1 halaman, desain template premium, 4-6 section standar, WhatsApp integration, domain .com atau .id, SSL certificate, 2x revisi.',
			price: '150000',
			priceCurrency: 'IDR',
			availability: 'https://schema.org/InStock',
			url: 'https://id.cherrypick.studio/#pricing',
		},
		{
			'@type': 'Offer',
			name: 'Website Professional',
			description:
				'Multi-page website 5 halaman, semi-custom design, SEO on-page, Google Analytics, domain dan hosting 1 tahun, 3x revisi, 1 bulan support teknis.',
			price: '300000',
			priceCurrency: 'IDR',
			availability: 'https://schema.org/InStock',
			url: 'https://id.cherrypick.studio/#pricing',
		},
		{
			'@type': 'Offer',
			name: 'E-commerce / Custom Website',
			description:
				'Toko online lengkap dengan payment gateway Midtrans/Xendit, ongkir otomatis, member area, admin dashboard, support 6 bulan.',
			price: '4500000',
			priceCurrency: 'IDR',
			availability: 'https://schema.org/InStock',
			url: 'https://id.cherrypick.studio/#pricing',
		},
	],
};
---

<!doctype html>
<html lang='id' class='scroll-smooth'>
	<head>
		<BaseHead
			title='Cherrypick - Jasa Pembuatan Website Profesional | Mudah & Cepat'
			description='Jasa pembuatan website profesional untuk bisnis UMKM hingga perusahaan. Harga terjangkau mulai Rp 150.000/bulan, desain modern, SEO friendly, dan siap pakai. Konsultasi gratis!'
			canonical='https://id.cherrypick.studio/'
			jsonLd={[localBusinessSchema, organizationSchema, websiteSchema, faqSchema, serviceSchema]}
		/>
	</head>
	<body
		class='min-h-screen flex flex-col bg-white dark:bg-[#282828] text-gray-900 dark:text-gray-100'
	>
		<noscript>
			<img
				height='1'
				width='1'
				style='display:none'
				src='https://www.facebook.com/tr?id=1993581981585697&ev=PageView&noscript=1'
				alt=''
			/>
		</noscript>
		<Navbar />
		<main class='flex flex-col gap-[120px]'>
			<SectionHero />
			<section id='about'>
				<SectionAboutUs />
			</section>
			<div class='w-full h-[1px] bg-[#D9D9D9] mx-auto'></div>
			<section id='process'>
				<SectionTime />
			</section>
			<SectionClient />
			<div class='w-full h-[1px] bg-[#D9D9D9] mx-auto'></div>
			<section id='portfolio'>
				<SectionPorto />
			</section>
			<div class='w-full h-[1px] bg-[#D9D9D9] mx-auto'></div>
			<section id='pricing'>
				<SectionPrice />
			</section>
			<SectionProjects />
			<SectionReview />
			<div class='w-full h-[1px] bg-[#D9D9D9] mx-auto'></div>
			<section id='faq'>
				<SectionFAQ />
			</section>
			<SectionBanner />
			<Footer />
		</main>
	</body>

	<style>
		html,
		body {
			margin: 0;
			width: 100%;
			height: 100%;
		}
		#pricing,
		#portfolio,
		#about,
		#process,
		#hero,
		#faq {
			scroll-margin-top: 5.5rem;
		}
	</style>
</html>
