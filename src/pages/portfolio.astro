---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionPorto from '../components/Section/SectionPorto.astro';
import SectionBanner from '../components/Section/SectionBanner.astro';
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <script is:inline>
      const theme = localStorage.getItem("theme") || "system";
      const isDark =
        theme === "dark" ||
        (theme === "system" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      if (isDark) document.documentElement.classList.add("dark");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>Portofolio - Cherrypick Studio</title>
    <meta
      name="description"
      content="Lihat portofolio website yang pernah kami kerjakan. Mulai dari UMKM hingga brand profesional, semua dikerjakan dengan standar desain terbaik."
    />
    <link rel="canonical" href="https://id.cherrypick.studio/portfolio" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://id.cherrypick.studio/portfolio" />
    <meta property="og:title" content="Portofolio - Cherrypick Studio" />
    <meta
      property="og:description"
      content="Lihat portofolio website yang pernah kami kerjakan. Mulai dari UMKM hingga brand profesional."
    />
    <meta property="og:image" content="https://id.cherrypick.studio/og-image.jpg" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Cherrypick Studio" />

    <meta name="theme-color" content="#C42026" />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="content-language" content="id" />
    <meta name="author" content="Cherrypick Studio" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZZSP9JYL3P"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-ZZSP9JYL3P");
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq("init", "1993581981585697");
      fbq("track", "PageView");
    </script>

    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "7187a12ab3084bbb92ace072d76d9c76"}'></script>
  </head>
  <body
    class="min-h-screen flex flex-col bg-white dark:bg-[#282828] text-gray-900 dark:text-gray-100"
  >
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1993581981585697&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>
    <Navbar />
    <main class="flex flex-col gap-[120px] mt-24">
      <section id="portfolio" class="pt-[100px]">
        <SectionPorto variant="grid" />
      </section>
      <SectionBanner />
      <Footer />
    </main>
  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
    #portfolio {
      scroll-margin-top: 5.5rem;
    }
  </style>
</html>
