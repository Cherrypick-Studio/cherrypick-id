---
import icBestPrice from '../../assets/ic-consultant.svg';
import icExpertTeam from '../../assets/ic-design.svg';
import icGoodDesign from '../../assets/ic-finance.svg';
import { whatsappUrlWithText } from '../../config';

interface Props {
	title?: string;
	desc?: string;
	showCta?: boolean;
}

const {
	title = 'Website Jadi Tepat Waktu & Terencana',
	desc = 'Setiap tahap dikerjakan secara rapi agar hasil sesuai kebutuhan bisnis Anda.',
	showCta = false,
} = Astro.props;

const aboutUsItems = [
	{
		title: 'Konsultasi & Kesepakatan',
		desc: 'Diskusi kebutuhan, tujuan website, target market, dan referensi desain. Dilanjutkan dengan finalisasi scope pekerjaan, harga, dan timeline pengerjaan.',
		image: icBestPrice,
	},
	{
		title: 'Design & Development',
		desc: 'Pembuatan tampilan desain yang modern dan sesuai branding bisnis Anda. Serta, proses coding website agar responsif, cepat, dan SEO friendly.',
		image: icExpertTeam,
	},
	{
		title: 'Review & Finalisasi',
		desc: 'Penyesuaian berdasarkan feedback agar hasil sesuai harapan. Dan untuk finalisasi, website siap online dan dapat langsung digunakan.',
		image: icGoodDesign,
	},
];
---

<div
	class='flex flex-col gap-[88px] max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 justify-center items-center'
>
	<div class='flex flex-col gap-6'>
		<h2
			class='text-[40px] text-[#1A1A1A] dark:text-[#FEFEFE] font-semibold max-w-[737px] mx-auto text-center'
		>
			{title}
		</h2>
		<p class='text-lg text-[#666666] dark:text-[#BBBBBB] text-center'>
			{desc}
		</p>

		{
			showCta && (
				<a
					href={whatsappUrlWithText(
						'Halo Cherrypick, saya mau konsultasi website untuk bisnis saya.',
					)}
					target='_blank'
					rel='noopener noreferrer'
					class='flex items-center gap-2 bg-[#C42026] dark:bg-white dark:text-[#1A1A1A] hover:opacity-80 text-white px-6 py-4 rounded-[12px] transition-opacity font-medium w-fit mx-auto'>
					<svg
						class='w-5 h-5'
						fill='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<path d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z' />
					</svg>
					Konsultasi via Gratis
				</a>
			)
		}
	</div>

	<div
		class='grid grid-cols-1 lg:grid-cols-3 gap-x-[56px] gap-y-[70px] mt-[100px]'
	>
		{
			aboutUsItems.map((item) => (
				<div class='w-full h-[240px] bg-[#F9F9F9] dark:bg-[#1A1A1A] shadow-xl flex flex-col gap-4 justify-end items-center p-6 relative rounded-[12px]'>
					<img
						src={item.image.src}
						alt={item.title}
						class='absolute -top-10'
						width='140'
						height='140'
					/>
					<h3 class='text-xl text-[#1A1A1A] dark:text-[#FEFEFE] font-semibold text-center'>
						{item.title}
					</h3>
					<p class='text-base text-[#666666] dark:text-[#BBBBBB] text-center font-normal'>
						{item.desc}
					</p>
				</div>
			))
		}
	</div>
</div>
