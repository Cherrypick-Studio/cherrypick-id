  },
  {
    title: "Gym & Fitness",
    desc: "FitCore",
    image: "/clients/fitcore.jpg",
    link: "https://www.instagram.com/p/DW5LQrFjbmR/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==",
  },
  {
    title: "Healty Food",
