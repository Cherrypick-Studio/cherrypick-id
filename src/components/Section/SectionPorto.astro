  },
  {
    title: "Konsultan Bisnis & Keuangan",
    desc: "Advico",
    image: "/clients/advico.jpg",
    link: "https://www.instagram.com/p/DXIoD6sDJIx/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==",
  },
  {
    title: "Kontraktor Bangunan",
    desc: "Construxa",
