    image: "/clients/tumpengmini.jpg",
    link: "https://tumpengmini.com/",
  },
  {
    title: "Florist & Bunga",
    desc: "Floweriablossom",
    image: "/clients/floweriablossom.jpg",
    link: "https://www.instagram.com/p/DVXx6iwDgLK/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==",
  },
  {
    title: "Furniture & Interior",
    desc: "Solenne",
    image: "/clients/solenne.jpg",
    link: "https://dribbble.com/shots/27329913-Solenne-Furniture-Website",
  },
  {
    title: "Gadget & Elektronik",
    desc: "Harwi Gadget",
    image: "/clients/harwigadget.jpg",
