    link: "https://dribbble.com/shots/27193343-LaundWash-Laundromat-Landing-Page",
  },
  {
    title: "Montessori School",
    desc: "Horizon",
    image: "/clients/horizon.jpg",
    link: "https://www.instagram.com/p/DU4ib1RjkTE/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==",
  },
  {
    title: "Portal Berita & Media",
    desc: "Cronicle",
