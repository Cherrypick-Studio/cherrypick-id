---

<div class="flex flex-col gap-[88px] justify-center items-center">
  <div class="flex flex-col gap-6 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      class="text-[40px] text-[#1A1A1A] dark:text-[#FEFEFE] font-semibold text-center mx-auto"
    >
      Portfolio Website yang Pernah Kami Kerjakan
    </h2>
    <p class="text-lg text-[#666666] dark:text-[#BBBBBB] text-center">
      Mulai dari UMKM hingga brand profesional, semua dikerjakan dengan standar
      desain modern dan SEO friendly.
    </p>
  </div>
  {
    variant === "carousel" ? (
      <Carousel speed={40} pauseOnHover={true} direction="left" gap={56}>
        {aboutUsItems.map((item) => (
          <div class="w-[400px] flex-shrink-0 h-fit flex flex-col gap-4 relative">
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-pointer"
              aria-label={`View ${item.title} project image`}
            >
              <img
                src={item.image}
                class="w-full h-[300px] rounded-xl object-cover"
                alt={`${item.title} - ${item.desc}`}
                width="400"
                height="300"
              />
            </a>
            <div class="flex w-full justify-between">
              <div class="flex flex-col gap-1">
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cursor-pointer"
                >
                  <span class="text-xl text-[#1A1A1A] dark:text-[#FEFEFE] font-semibold">
                    {item.title}
                  </span>
                </a>
                <p class="text-base text-[#666666] dark:text-[#BBBBBB] font-normal">
                  {item.desc}
                </p>
              </div>
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#C42026] h-fit p-3 rounded-[8px] cursor-pointer"
                aria-label={`View ${item.title} project`}
              >
                <svg
                  stroke="currentColor"
                  fill="currentColor"
                  stroke-width="0"
                  viewBox="0 0 448 512"
                  color="#FEFEFE"
                  style="color:#FEFEFE"
                  height="20"
                  width="20"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </Carousel>
    ) : (
      <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-12 items-center">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[56px]"
          id="porto-grid"
        >
          {aboutUsItems.map((item) => (
            <div class="w-full h-fit flex flex-col gap-4 relative">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="cursor-pointer"
                aria-label={`View ${item.title} project image`}
              >
                <img
                  src={item.image}
                  class="w-full h-[300px] rounded-xl object-cover"
                  alt={`${item.title} - ${item.desc}`}
                  width="400"
                  height="300"
                />
              </a>
              <div class="flex w-full justify-between">
                <div class="flex flex-col gap-1">
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cursor-pointer"
                  >
                    <span class="text-xl text-[#1A1A1A] dark:text-[#FEFEFE] font-semibold">
                      {item.title}
                    </span>
                  </a>
                  <p class="text-base text-[#666666] dark:text-[#BBBBBB] font-normal">
                    {item.desc}
                  </p>
                </div>
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-[#C42026] h-fit p-3 rounded-[8px] cursor-pointer"
                  aria-label={`View ${item.title} project`}
                >
                  <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 448 512"
                    color="#FEFEFE"
                    style="color:#FEFEFE"
                    height="20"
                    width="20"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>